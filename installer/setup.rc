// Vetro Look, GPL-3.0-or-later.
// The real VetroLook.exe, embedded whole. CMake writes payload_path.h with
// the paths to the just-built payloads before this compiles.
#include "payload_path.h"
#define IDR_PAYLOAD 1
#define IDR_UNINSTALL 2
#define IDR_README 3
#define IDR_NOTICES 4
IDR_PAYLOAD RCDATA PAYLOAD_PATH
IDR_UNINSTALL RCDATA UNINSTALL_PATH
IDR_README RCDATA INSTALL_README_PATH
IDR_NOTICES RCDATA NOTICES_PATH
